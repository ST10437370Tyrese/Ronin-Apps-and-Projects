<Window x:Class="GetWellHospital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Well Hospital - Billing System" 
        Height="550" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Get Well Hospital" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Please enter the following information in order to prepare your bill" 
                   FontSize="14" FontStyle="Italic" Margin="0,0,0,20" TextWrapping="Wrap"/>

        <!-- Patient Name -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Patient name:" Width="120" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPatientName" Width="300" Margin="10,0"/>
        </StackPanel>

        <!-- Patient Type -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="Type of patient" Width="120" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <RadioButton x:Name="rbInPatient" Content="In Patient" 
                             GroupName="PatientType" Margin="0,0,20,0"
                             Checked="RbPatientType_Checked"/>
                <RadioButton x:Name="rbOutPatient" Content="Out Patient" 
                             GroupName="PatientType" Margin="0,0,20,0"
                             Checked="RbPatientType_Checked" IsChecked="True"/>
            </StackPanel>
        </StackPanel>

        <!-- Medical Charges -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Medical charges:" Width="120" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMedicalCharges" Width="150" Margin="10,0"/>
            <TextBlock Text="R" Margin="5,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Hospital Services -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Hospital services:" Width="120" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtHospitalServices" Width="150" Margin="10,0"/>
            <TextBlock Text="R" Margin="5,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- In-Patient Section (initially collapsed) -->
        <Border x:Name="borderInPatient" Grid.Row="6" 
                BorderBrush="Gray" BorderThickness="1" 
                CornerRadius="5" Padding="10" Margin="0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="For In Patient:" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Number of Days -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Number of days:" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtNumberOfDays" Width="100" Margin="10,0"/>
                </StackPanel>

                <!-- Room Type -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Select type of room:" Margin="0,0,0,5"/>
                    <RadioButton x:Name="rbPrivateRoom" Content="Private room" 
                                 GroupName="RoomType" Margin="20,5"/>
                    <RadioButton x:Name="rbThreeBedRoom" Content="Three bed room" 
                                 GroupName="RoomType" Margin="20,5" IsChecked="True"/>
                    <RadioButton x:Name="rbSixBedRoom" Content="Six bed room" 
                                 GroupName="RoomType" Margin="20,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnCalculate" Content="Calculate" 
                    Width="100" Height="35" Margin="10"
                    Background="LightGreen" Click="BtnCalculate_Click"/>
            <Button x:Name="btnClear" Content="Clear" 
                    Width="100" Height="35" Margin="10"
                    Background="LightCoral" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Result -->
        <Border Grid.Row="8" BorderBrush="Black" BorderThickness="2" 
                CornerRadius="5" Padding="10" Margin="0,10" 
                Background="LightYellow">
            <StackPanel>
                <TextBlock Text="The cost of your bill is:" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="txtResult" FontSize="18" FontWeight="Bold" 
                           Foreground="Green" Margin="0,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>