<Window x:Class="TempConvertor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temperature Converter" Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Converter" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Instruction Text -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                   Text="Conversion from Celsius to Fahrenheit" 
                   FontSize="14" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"/>

        <!-- Label: Please enter degree Celsius -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Please enter degree Celsius" 
                   FontSize="12" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10"/>

        <!-- TextBox for Celsius input -->
        <TextBox Grid.Row="2" Grid.Column="1" 
                 x:Name="txtCelsius" 
                 Width="150" Height="25" 
                 HorizontalAlignment="Left"
                 Margin="0,0,0,10"/>

        <!-- Convert button -->
        <Button Grid.Row="2" Grid.Column="0" 
                x:Name="btnConvert" 
                Content="Convert" 
                Width="100" 
                HorizontalAlignment="Left"
                Margin="0,35,0,0"
                Click="btnConvert_Click" Grid.RowSpan="2"/>

        <!-- Result display -->
        <StackPanel Grid.Row="3" Grid.Column="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,10">
            <TextBlock Text="Equivalent degree Fahrenheit: " 
                       FontSize="12" 
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="lblResult" 
                       Text="" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Foreground="Blue"/>
        </StackPanel>

        <!-- Clear button -->
        <Button Grid.Row="3" Grid.Column="0" 
                x:Name="btnClear" 
                Content="Clear" 
                Width="100" 
                HorizontalAlignment="Left"
                Click="btnClear_Click" Margin="0,40,0,10" Grid.RowSpan="3"/>

    </Grid>
</Window>